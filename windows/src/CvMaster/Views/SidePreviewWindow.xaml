<Window x:Class="CvMaster.Views.SidePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CvMaster.Controls"
        Width="310"
        Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
  <Border Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="15,12,12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:Icon x:Name="PreviewKindIcon"
                       Width="14"
                       Height="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock x:Name="PreviewTypeText"
                   Grid.Column="1"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="PinButton"
                Grid.Column="2"
                Style="{StaticResource TextButtonStyle}"
                Click="PinButton_Click">
          <StackPanel Orientation="Horizontal">
            <controls:Icon Width="12"
                           Height="12"
                           Margin="0,0,4,0"
                           Data="{StaticResource Icon.Pin}" />
            <TextBlock x:Name="PinButtonText" Text="置顶" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="1"
              Height="1"
              Margin="15,0"
              Background="{DynamicResource BorderBrush}" />

      <ScrollViewer Grid.Row="2"
                    Margin="15,10,8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Image x:Name="PreviewImage"
                 MaxHeight="240"
                 HorizontalAlignment="Left"
                 Stretch="Uniform"
                 Visibility="Collapsed"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBox x:Name="PreviewText"
                   Style="{StaticResource ReadOnlyPreviewTextBoxStyle}"
                   Visibility="Collapsed" />
          <TextBlock x:Name="PreviewEmpty"
                     Margin="0,8,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>

      <TextBlock x:Name="FooterText"
                 Grid.Row="3"
                 Margin="15,9,15,11"
                 FontSize="10"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</Window>
