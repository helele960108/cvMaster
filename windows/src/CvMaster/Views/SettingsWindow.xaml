<Window x:Class="CvMaster.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CvMaster.Controls"
        Title="cvMaster 设置"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized">
  <Window.Resources>
    <Style x:Key="SettingsNavStyle" TargetType="ToggleButton">
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="15,4" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SettingsSectionStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="2,0,0,8" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,3,12,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LineHeight" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowSeparatorStyle" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="14">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="158" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧导航 -->
      <Border Background="{DynamicResource SubtleBrush}" CornerRadius="14,0,0,14">
        <Grid Margin="13,18,13,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0"
                      Margin="7,0,0,22"
                      Orientation="Horizontal"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <controls:Icon Width="18"
                           Height="18"
                           Data="{StaticResource Icon.Clipboard}"
                           Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="cvMaster" />
          </StackPanel>

          <StackPanel Grid.Row="1">
            <TextBlock Margin="9,0,0,6"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="设置" />
            <ToggleButton x:Name="GeneralTab"
                          Tag="0"
                          IsChecked="True"
                          Style="{StaticResource SettingsNavStyle}"
                          Click="Tab_Click">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Width="14"
                               Height="14"
                               Margin="0,0,9,0"
                               Data="{StaticResource Icon.Settings}" />
                <TextBlock VerticalAlignment="Center" Text="通用" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="PrivacyTab"
                          Tag="1"
                          Margin="0,3,0,0"
                          Style="{StaticResource SettingsNavStyle}"
                          Click="Tab_Click">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Width="14"
                               Height="14"
                               Margin="0,0,9,0"
                               Data="{StaticResource Icon.Shield}" />
                <TextBlock VerticalAlignment="Center" Text="记录与隐私" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="StorageTab"
                          Tag="2"
                          Margin="0,3,0,0"
                          Style="{StaticResource SettingsNavStyle}"
                          Click="Tab_Click">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Width="14"
                               Height="14"
                               Margin="0,0,9,0"
                               Data="{StaticResource Icon.Drive}" />
                <TextBlock VerticalAlignment="Center" Text="存储与清理" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>

          <Border Grid.Row="3"
                  Padding="10,9"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:Icon Width="12"
                               Height="12"
                               Margin="0,0,5,0"
                               Data="{StaticResource Icon.Shield}"
                               Foreground="{DynamicResource GreenBrush}" />
                <TextBlock FontSize="10"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="本地优先" />
              </StackPanel>
              <TextBlock Margin="0,4,0,0"
                         FontSize="9"
                         LineHeight="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="不联网，内容只保存在本机。"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- 内容区 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="24,18,16,12"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <StackPanel>
            <TextBlock x:Name="PageTitle"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="通用" />
            <TextBlock x:Name="PageSubtitle"
                       Margin="0,4,0,0"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="记录方式、粘贴行为与外观" />
          </StackPanel>
          <Button HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Style="{StaticResource IconButtonStyle}"
                  ToolTip="关闭设置"
                  Click="CloseButton_Click">
            <controls:Icon Width="14" Height="14" Data="{StaticResource Icon.Close}" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="24,0,10,0"
                      Padding="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Grid>
            <!-- 通用 -->
            <StackPanel x:Name="GeneralPanel">
              <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="记录" />
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="允许记录剪贴板" />
                      <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                 Text="复制文本、链接、图片和文件引用；首次使用时默认关闭。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SwitchStyle}"
                                  IsChecked="{Binding RecordingEnabled, Mode=TwoWay}" />
                  </Grid>
                  <Border Style="{StaticResource SettingsRowSeparatorStyle}" />
                  <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="自动粘贴到原窗口" />
                      <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                 Text="选择记录后恢复原输入位置并发送 Ctrl+V；关闭时只复制到剪贴板。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SwitchStyle}"
                                  IsChecked="{Binding AutoPaste, Mode=TwoWay}" />
                  </Grid>
                  <Border Style="{StaticResource SettingsRowSeparatorStyle}" />
                  <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="登录时启动" />
                      <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                 Text="仅注册当前用户的启动项，使用后台模式启动，不打开窗口。" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SwitchStyle}"
                                  IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="唤起与外观" />
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="全局快捷键" />
                      <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                 Text="在任意应用中使用；点击右侧按钮可录入新组合。" />
                    </StackPanel>
                    <Button x:Name="HotKeyButton"
                            Grid.Column="1"
                            MinWidth="116"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="HotKeyButton_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HotKeyText"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="{Binding ShortcutDisplay}" />
                        <controls:Icon Width="11"
                                       Height="11"
                                       Margin="7,0,0,0"
                                       Data="{StaticResource Icon.Edit}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Border Style="{StaticResource SettingsRowSeparatorStyle}" />
                  <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="外观" />
                      <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                 Text="立即应用；跟随系统时随 Windows 主题切换。" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SubtleBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                      <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="AppearanceSystem"
                                      Padding="9,5"
                                      Style="{StaticResource TabToggleStyle}"
                                      Tag="system"
                                      Click="Appearance_Click"
                                      Content="跟随系统" />
                        <ToggleButton x:Name="AppearanceLight"
                                      Padding="9,5"
                                      Style="{StaticResource TabToggleStyle}"
                                      Tag="light"
                                      Click="Appearance_Click"
                                      Content="浅色" />
                        <ToggleButton x:Name="AppearanceDark"
                                      Padding="9,5"
                                      Style="{StaticResource TabToggleStyle}"
                                      Tag="dark"
                                      Click="Appearance_Click"
                                      Content="深色" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Margin="0,0,0,14"
                      Padding="13,11"
                      Background="{DynamicResource AccentSoftBrush}"
                      CornerRadius="9">
                <StackPanel Orientation="Horizontal">
                  <controls:Icon Width="14"
                                 Height="14"
                                 Margin="0,1,9,0"
                                 VerticalAlignment="Top"
                                 Data="{StaticResource Icon.Info}"
                                 Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock MaxWidth="360"
                             FontSize="10"
                             LineHeight="15"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="cvMaster 只保留托盘图标。关闭记录后不会追溯保存当前剪贴板；已有历史仍可搜索和粘贴。"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 记录与隐私 -->
            <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
              <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="敏感内容" />
              <Border Style="{StaticResource SettingsCardStyle}">
                <Grid Margin="0,11">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="跳过敏感与瞬时内容" />
                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                               Text="识别 Windows 与跨平台剪贴板隐私标记，例如密码管理器声明不记录的内容。" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource SwitchStyle}"
                                IsChecked="{Binding SkipSensitive, Mode=TwoWay}" />
                </Grid>
              </Border>

              <Grid Margin="2,0,0,8">
                <TextBlock VerticalAlignment="Center"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="排除来源应用" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBlock Margin="0,0,9,0"
                             VerticalAlignment="Center"
                             FontSize="9"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Text="{Binding ExcludedCountText}" />
                  <Button x:Name="AddExcludedButton"
                          Style="{StaticResource TextButtonStyle}"
                          Click="AddExcludedButton_Click">
                    <StackPanel Orientation="Horizontal">
                      <controls:Icon Width="11"
                                     Height="11"
                                     Margin="0,0,3,0"
                                     Data="{StaticResource Icon.Plus}" />
                      <TextBlock Text="添加应用…" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <Border Style="{StaticResource SettingsCardStyle}" Padding="15,6">
                <Grid>
                  <ItemsControl ItemsSource="{Binding ExcludedApplications}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="45">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <controls:SourceBadge Width="19"
                                                Height="19"
                                                VerticalAlignment="Center"
                                                ProcessName="{Binding ProcessName}"
                                                DisplayName="{Binding DisplayName}" />
                          <StackPanel Grid.Column="1"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center">
                            <TextBlock FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding ProcessName}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Width="26"
                                  Height="26"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource IconButtonStyle}"
                                  Tag="{Binding ProcessName}"
                                  ToolTip="取消排除"
                                  Click="RemoveExcludedButton_Click">
                            <controls:Icon Width="12"
                                           Height="12"
                                           Data="{StaticResource Icon.Close}" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="ExcludedEmpty"
                              Margin="0,18"
                              HorizontalAlignment="Center"
                              IsHitTestVisible="False">
                    <controls:Icon Width="22"
                                   Height="22"
                                   Margin="0,0,0,7"
                                   HorizontalAlignment="Center"
                                   Data="{StaticResource Icon.Shield}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="尚未排除任何应用" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Margin="0,0,0,14"
                      Padding="13,11"
                      Background="{DynamicResource SubtleBrush}"
                      CornerRadius="9">
                <StackPanel>
                  <TextBlock FontSize="10"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Text="来源识别并不构成绝对安全边界" />
                  <TextBlock Margin="0,4,0,0"
                             FontSize="10"
                             LineHeight="15"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="敏感标记取决于应用是否声明，不能保证过滤所有密码。排除规则按进程名匹配，已有历史不受影响。"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,6,0,0"
                             FontSize="10"
                             LineHeight="15"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="内容仅保存在本机且不联网；文件只保存引用，不备份原文件。数据未采用应用级加密，删除也不等于安全擦除系统备份。"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 存储与清理 -->
            <StackPanel x:Name="StoragePanel" Visibility="Collapsed">
              <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="本地占用" />
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Margin="0,11">
                  <Grid>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="历史内容" />
                      <TextBlock Margin="0,4,0,0"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Text="{Binding StorageUsageText}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <ProgressBar Margin="0,12,0,8"
                               Maximum="1"
                               Style="{StaticResource StorageProgressStyle}"
                               Value="{Binding StorageProgress, Mode=OneWay}" />
                  <TextBlock FontSize="9"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Text="内容量仅统计内容表示，不含数据库、WAL 与引用的原文件。"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock Style="{StaticResource SettingsSectionStyle}" Text="保留规则" />
              <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                  <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="历史保留" />
                      <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                 Text="新内容入库时清理过期记录；仍受 10,000 条与 1 GB 上限约束。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="98"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RetentionButton_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RetentionTextBlock"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="{Binding RetentionText}" />
                        <controls:Icon Width="10"
                                       Height="10"
                                       Margin="6,0,0,0"
                                       Data="{StaticResource Icon.ChevronDown}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Border Style="{StaticResource SettingsRowSeparatorStyle}" />
                  <Grid Margin="0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SettingsLabelStyle}" Text="清理历史" />
                      <TextBlock Style="{StaticResource SettingsDescriptionStyle}"
                                 Text="按时间清理会删除包含置顶与分组在内的记录，但保留分组结构。" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="CleanupButton_Click">
                      <StackPanel Orientation="Horizontal">
                        <controls:Icon Width="12"
                                       Height="12"
                                       Margin="0,0,5,0"
                                       Data="{StaticResource Icon.Trash}"
                                       Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="清理历史…" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Margin="0,0,0,14"
                      Padding="13,11"
                      Background="{DynamicResource SubtleBrush}"
                      CornerRadius="9">
                <StackPanel>
                  <TextBlock FontSize="10"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Text="自动清理会保护置顶与已分组内容" />
                  <TextBlock Margin="0,4,0,0"
                             FontSize="10"
                             LineHeight="15"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="达到容量上限时，自动清理优先移除未受保护的旧记录；保护内容占满容量时拒绝新增。手动清理不受此保护限制。"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,6,0,0"
                             FontSize="10"
                             LineHeight="15"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="单条内容最多 16 MB，每种表示最多 8 MB；引用文件的原始文件不会被复制或删除。"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid Margin="24,7,18,8">
            <TextBlock FontSize="9"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{Binding Feedback}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock HorizontalAlignment="Right"
                       FontSize="9"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="本地存储 · 无网络" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
