<Project Sdk="Microsoft.NET.Sdk">
  <!-- 无 UI 的核心冒烟验证：使用临时目录，不接触真实剪贴板与用户历史。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CvMaster.SmokeTests</RootNamespace>
    <AssemblyName>CvMaster.SmokeTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CvMaster.Core\CvMaster.Core.csproj" />
    <!-- 运行 Windows 托盘的纯逻辑检查，而不让核心冒烟依赖 WPF / Win32。 -->
    <Compile Include="..\CvMaster\Services\TrayPresentation.cs" Link="TrayPresentation.cs" />
    <Compile Include="..\CvMaster\Services\TrayIconFrames.cs" Link="TrayIconFrames.cs" />
  </ItemGroup>
</Project>
